[Unit]
Description=EnergyBrew unfrozen 05:45 morning research preview (NO EMAIL)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
AssertPathIsDirectory=/opt/energybrew/energybrew-state

[Service]
Type=oneshot
ExecStart=/usr/bin/docker run --rm --name energybrew-preflight --mount type=bind,source=/opt/energybrew/energybrew-state,target=/data --entrypoint python energybrew-collector:latest morning_readiness.py --rss /data/articles.json --discovery /data/discovery.json --releases /data/press_releases.json --output /data/morning --preflight --time-zone America/Chicago
TimeoutStartSec=8min
