[Unit]
Description=EnergyBrew safe pre-cutoff publisher RSS metadata refresh (NO EMAIL)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
AssertPathIsDirectory=/opt/energybrew/energybrew-state

[Service]
Type=oneshot
ExecStart=/usr/bin/docker run --rm --name energybrew-rss-preflight --mount type=bind,source=/opt/energybrew/energybrew-state,target=/data --entrypoint python energybrew-collector:latest host_rss_refresh.py --root /data
TimeoutStartSec=8min
